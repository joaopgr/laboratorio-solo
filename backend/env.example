# Database - Substitua pela URL do Supabase
# Para Supabase: Settings → Database → Connection string (URI)
DATABASE_URL="postgresql://postgres:SENHA@db.xxxxx.supabase.co:5432/postgres"

# JWT Secret - Gere um secret forte e aleatório para produção
JWT_SECRET="seu_jwt_secret_super_seguro_aqui_mude_para_um_secret_forte"

# Server
PORT=3001
NODE_ENV="development"

# CORS - URL do seu frontend
# Local: http://localhost:3000
# Vercel: https://seu-frontend.vercel.app
FRONTEND_URL="http://localhost:3000"
